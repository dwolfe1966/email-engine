APP_NAME="Email Platform"
ENVIRONMENT=local
CORS_ORIGINS='["*"]'
DATABASE_URL=postgresql+psycopg://email_platform:email_platform@localhost:5432/email_platform
DATABASE_MIGRATION_URL=
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=no-reply@example.com
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
UNSUBSCRIBE_SECRET=change-me
REQUIRE_GUI_AUTH=false
BOOTSTRAP_OPERATOR_EMAIL=
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_OPERATOR_DISPLAY_NAME="Production Operator"
BOOTSTRAP_OPERATOR_ROLE=admin
